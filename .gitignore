node_modules/
dist/
*.log
.DS_Store

# Downloaded model files (large, reproducible)
models/

# Secrets: never commit
.env
.env.*
!.env.example

# Runtime logs
logs/

# Swift build output (ARK Island)
.build/
apps/mac/island/build/

# Rust build output (ADR-278)
rust/target/

# ARK Island settings (written by the runtime on model.set)
config/island.json
# The owner's name (ADR-271) and the AI programs ARK may use (ADR-269): personal, never in git
config/owner.json
config/ai-programs.json
config/local-backup.json
config/local-backup.json.*.tmp

# Design mockup renders (regenerate from the HTML / the island gallery)
sketches/**/*.png
sketches/review/
sketches/**/tmp/

# ARK memory (ADR-058): personal, local only
data/

# Flaticon UIcons: each Mac downloads its own copy (scripts/setup.sh); the licence does not allow sharing it in git.
assets/fonts/vendor/
