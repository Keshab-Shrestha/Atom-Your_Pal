{
  "name": "zeno",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env apps/mac/src/main.ts",
    "voice:check": "node --env-file-if-exists=.env apps/mac/src/voice-check.ts",
    "test": "node --test \"**/*.test.ts\"",
    "test:live": "ZENO_LIVE_TESTS=1 node --env-file-if-exists=.env --test \"**/*.live.test.ts\"",
    "typecheck": "tsc",
    "island:build": "apps/mac/island/build-app.sh",
    "island:open": "apps/mac/island/build-app.sh --open",
    "island:test": "apps/mac/island/test.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2"
  }
}
