# Copy to .env and fill in. Loaded automatically by `pnpm start`.
# .env is git-ignored. Never commit real secrets.

# ZENO runs on your own Claude plan (ADR-092): no API key, only Claude Code installed and signed in
# (`claude auth login`). ZENO finds `claude` by itself; set this if it is somewhere unusual:
# ZENO_CLAUDE_PATH=/full/path/to/claude

# Optional (defaults shown)
# ZENO_LLM_MODEL=claude-sonnet-5-5   # or claude-opus-5-5, claude-haiku-4-5-20251001 (also chosen in Settings → AI model)
# ZENO_LLM_TIMEOUT_MS=30000
# ZENO_AUDIO_INPUT_DEVICE=:default   # follows macOS (changes when devices are plugged in); or a name from pressing d, e.g. ":Webcam internal mic"
# ZENO_AUDIO_SAMPLE_RATE=16000
# ZENO_STT_MODEL=models/ggml-small.en.bin   # best balance; ggml-base.en.bin is faster, less accurate
# ZENO_STT_LANGUAGE=en         # or "auto" (needs a multilingual model)
# ZENO_STT_VOCABULARY=ZENO     # comma-separated names/places Whisper should expect, e.g. ZENO, Keshab, Kathmandu
# ZENO_TTS_VOICE=af_heart      # Kokoro voice, e.g. af_bella, am_michael, bf_emma
# ZENO_TTS_DTYPE=fp32          # fp32 (~330 MB, default, fastest on Apple silicon) or q8 (~90 MB)
# ZENO_LOG_LEVEL=info          # debug | info | warn | error
# ZENO_LOG_FILE=logs/zeno.log  # structured log (JSON Lines); records events and timings, never what was said
# ZENO_FRONT_WINDOW=0          # turn off the front_window tool (ADR-072): app in front, plus tab title and address in Chrome/Arc/Edge/Brave
# ZENO_SHORTCUTS=0             # turn off shortcuts (ADR-071): plain commands such as "open Brave" or "pause" run without the model
# ZENO_HELPERS_FILE=data/helpers.db   # helpers' apps, jobs and reports (ADR-081); local only, gitignored
# ZENO_PAPERCLIP_URL=http://localhost:3100   # your own Paperclip (Task 3.16); loopback only, off when unset
# ZENO_PAPERCLIP_COMPANY=                    # its company id (default: the first company)
# ADR-098: ZENO's own Telegram bot (make a new bot with @BotFather; not Hermes' bot). Off unless both are set.
ZENO_TELEGRAM_BOT_TOKEN=
ZENO_TELEGRAM_CHAT_ID=
# ZENO_API_PORT=4790           # ADR-098 item 5: the local API's port (127.0.0.1 only; off until Settings → General → Local API)
