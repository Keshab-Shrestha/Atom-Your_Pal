# Copy to .env and fill in. Loaded automatically by `pnpm start`.
# .env is git-ignored. Never commit real secrets.

# LLM provider: claude (default), claude-plan or gemini. Only the selected provider needs a key (claude-plan needs none).
# ZENO_LLM_PROVIDER=claude        # claude, claude-plan or gemini
# claude-plan = Claude on your own Claude plan: needs no key, only Claude Code installed and signed in (`claude auth login`).
# Optional: ZENO_CLAUDE_PATH=/full/path/to/claude
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional (defaults shown)
# ZENO_LLM_MODEL=              # default: claude-sonnet-5 (claude) or gemini-3.6-flash (gemini)
# ZENO_LLM_TIMEOUT_MS=30000
# ZENO_AUDIO_INPUT_DEVICE=:default   # follows macOS (changes when devices are plugged in); or a name from pressing d, e.g. ":Webcam internal mic"
# ZENO_AUDIO_SAMPLE_RATE=16000
# ZENO_STT_MODEL=models/ggml-small.en.bin   # best balance; ggml-base.en.bin is faster, less accurate
# ZENO_STT_LANGUAGE=en         # or "auto" (needs a multilingual model)
# ZENO_STT_VOCABULARY=ZENO     # comma-separated names/places Whisper should expect, e.g. ZENO, Keshab, Kathmandu
# ZENO_TTS_VOICE=af_heart      # Kokoro voice, e.g. af_bella, am_michael, bf_emma
# ZENO_TTS_DTYPE=fp32          # fp32 (~330 MB, default, fastest on Apple silicon) or q8 (~90 MB)
# ZENO_LOG_LEVEL=info          # debug | info | warn | error
# ZENO_LOG_FILE=logs/zeno.log  # structured log (JSON Lines); records events and timings, never what was said
